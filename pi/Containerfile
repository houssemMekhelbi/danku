FROM localhost/ai-base:1
USER root
# claude-code too: pi-claude-bridge drives it (pathToClaudeCodeExecutable in ~/.pi/agent/claude-bridge.json),
# the SDK's bundled binary cannot refresh OAuth through the proxy.
RUN npm install -g @earendil-works/pi-coding-agent@1.3.0 @anthropic-ai/claude-code@2.1.302 && npm cache clean --force
USER agent
# pi packages (pi-claude-bridge, pi-subagents) live in $HOME/.pi/agent/npm and persist in the harness home.
ENTRYPOINT ["pi"]
